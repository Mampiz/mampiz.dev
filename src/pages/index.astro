---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProfileCard from "../components/ProfileCard.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import WorkIndex from "../components/WorkIndex.astro";
import ProjectSection from "../components/ProjectSection.astro";
import Experience from "../components/Experience.astro";
import Upstream from "../components/Upstream.astro";
import TeamWork from "../components/TeamWork.astro";
import Stack from "../components/Stack.astro";
import About from "../components/About.astro";
import Archive from "../components/Archive.astro";
import PlayBanner from "../components/PlayBanner.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/site";
---

<Layout>
  <Header />

  <!-- Proportions taken from the reference: a 344px card, 100px of air, a 696px column. -->
  <div
    class="mx-auto w-full max-w-[calc(1140px+3rem)] px-6 pt-24 lg:grid lg:grid-cols-[300px_minmax(0,1fr)] lg:items-start lg:gap-14 lg:pt-[160px] xl:grid-cols-[344px_minmax(0,1fr)] xl:gap-[100px]"
  >
    <ProfileCard />

    <main class="mt-14 min-w-0 lg:mt-0">
      <Hero />

      <section id="work" class="section scroll-mt-10">
        <SectionHead title="Recent" ghost="projects" />
        <WorkIndex />
      </section>

      <Experience />
      <Stack />
      <Upstream />

      <section class="section" aria-label="Case studies">
        <SectionHead title="How they" ghost="work" />
        <div class="mt-5">
          {projects.map((project) => <ProjectSection project={project} />)}
        </div>
      </section>

      <TeamWork />
      <About />
      <Archive />
      <PlayBanner />
      <Contact />
    </main>
  </div>

  <Footer />
</Layout>
