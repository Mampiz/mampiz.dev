---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProfileCard from "../components/ProfileCard.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import WorkIndex from "../components/WorkIndex.astro";
import ProjectSection from "../components/ProjectSection.astro";
import Upstream from "../components/Upstream.astro";
import TeamWork from "../components/TeamWork.astro";
import Stack from "../components/Stack.astro";
import About from "../components/About.astro";
import Archive from "../components/Archive.astro";
import PlayBanner from "../components/PlayBanner.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/site";
---

<Layout>
  <Header />

  <div
    class="shell pt-20 md:pt-28 lg:grid lg:grid-cols-[19.5rem_minmax(0,1fr)] lg:items-start lg:gap-14 xl:grid-cols-[21rem_minmax(0,1fr)] xl:gap-20"
  >
    <ProfileCard />

    <main class="mt-12 min-w-0 lg:mt-0">
      <Hero />

      <section id="work" class="scroll-mt-24 border-t border-line pt-16 md:pt-24">
        <SectionHead title="Selected" ghost="work" />
        <WorkIndex />
        <div class="mt-6">
          {projects.map((project) => <ProjectSection project={project} />)}
        </div>
      </section>

      <Upstream />
      <TeamWork />
      <Stack />
      <About />
      <Archive />
      <PlayBanner />
      <Contact />
    </main>
  </div>

  <Footer />
</Layout>
