---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectSection from "../components/ProjectSection.astro";
import Stack from "../components/Stack.astro";
import About from "../components/About.astro";
import Archive from "../components/Archive.astro";
import Contact from "../components/Contact.astro";
import { projects } from "../data/site";
---

<Layout>
  <Header />

  <main>
    <Hero />

    <section id="work" class="shell scroll-mt-24 pt-24 md:pt-32">
      <SectionHead
        index="01"
        title="Selected work"
        blurb="Four systems, each one running and measured. Every number below came out of a benchmark or a coverage report, not out of a feeling."
      />

      <div class="mt-14 md:mt-16">
        {
          projects.map((project, i) => (
            <ProjectSection project={project} flip={i % 2 === 1} />
          ))
        }
      </div>
    </section>

    <Stack />
    <About />
    <Archive />
    <Contact />
  </main>
</Layout>
