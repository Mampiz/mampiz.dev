---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { person } from "../data/site";
import { siteBase } from "../lib/url";
---

<Layout title={`Not found · ${person.short}`} description="This page does not exist.">
  <Header standalone />

  <main class="relative grid min-h-screen place-items-center overflow-hidden px-6">
    <div
      class="glow left-1/2 top-1/3 h-[24rem] w-[38rem] -translate-x-1/2 opacity-80"
      aria-hidden="true"
    >
    </div>

    <div class="relative text-center">
      <p class="label">Error</p>
      <p
        class="mt-4 font-display text-[clamp(4rem,16vw,9rem)] font-semibold leading-none tracking-[-0.05em] text-accent"
      >
        404
      </p>
      <p class="mx-auto mt-6 max-w-md text-[1.0625rem] leading-relaxed text-dim">
        Nothing lives at this address. It was either moved, or it never existed and
        something linked to it anyway.
      </p>
      <p class="mt-6 text-sm text-mute">
        There is a
        <a
          href={`${siteBase}/snake`}
          class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
          >game hidden on this site</a
        >, if you would rather do that than leave.
      </p>

      <a href={`${siteBase}/`} class="btn btn-primary mt-8">
        Back to the work
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </main>
</Layout>
