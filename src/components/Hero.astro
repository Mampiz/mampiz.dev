---
import { person, projects } from "../data/site";
import { thumb } from "../lib/url";

// The rail is the first thing a visitor sees: every real screenshot and
// recording from the projects, scrolling past, each one a link into its case
// study. Duplicated once so the marquee can loop seamlessly.
const rail = projects.flatMap((project) =>
  project.media.map((item) => ({
    src: item.src,
    alt: item.alt,
    caption: item.caption ?? project.name,
    name: project.name,
    href: `#${project.slug}`,
  })),
);
const loop = [...rail, ...rail];
---

<section id="top" class="relative overflow-hidden pt-28 md:pt-36">
  <div class="grid-bg" aria-hidden="true"></div>
  <div
    class="glow left-1/2 top-[-14rem] h-[26rem] w-[46rem] -translate-x-1/2 opacity-70"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative">
    <div
      class="reveal inline-flex items-center gap-2.5 rounded-full border border-line bg-surface/60 px-3.5 py-1.5 backdrop-blur"
    >
      <span class="pulse-dot" aria-hidden="true"></span>
      <span class="font-mono text-[0.6875rem] tracking-[0.14em] uppercase text-dim">
        {person.location} · {person.availability}
      </span>
    </div>

    <h1
      class="reveal mt-8 max-w-[19ch] font-display text-[clamp(2.6rem,7.6vw,5.75rem)] font-semibold leading-[0.94] tracking-[-0.045em]"
      style="--reveal-delay:60ms"
    >
      I build the layer<br class="hidden sm:block" /> other engineers
      <span class="relative whitespace-nowrap"
        >stand on<svg
          class="absolute -bottom-1 left-0 h-[0.35em] w-full text-accent"
          viewBox="0 0 300 12"
          preserveAspectRatio="none"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 8.5C60 3.5 140 2.5 298 6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg></span
      >.
    </h1>

    <div class="mt-9 grid gap-10 md:mt-12 md:grid-cols-12 md:items-end">
      <p
        class="reveal max-w-2xl text-[1.0625rem] leading-relaxed text-dim md:col-span-7 md:text-lg"
        style="--reveal-delay:140ms"
      >
        Software engineer in {person.location}. Embedded automotive code by day —
        bootloaders, AUTOSAR, secure boot — and Kubernetes controllers by night.
        Both jobs are the same job: make the thing underneath reliable enough that
        nobody has to think about it.
      </p>

      <div
        class="reveal flex flex-wrap items-center gap-3 md:col-span-5 md:justify-end"
        style="--reveal-delay:200ms"
      >
        <a href="#work" class="btn btn-primary">
          See the work
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M6 13l6 6 6-6"></path>
          </svg>
        </a>
        <a href={person.github} class="btn btn-ghost" rel="me noopener">
          GitHub
          <svg
            class="arrow h-3 w-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Visual index of every project screenshot, straight away. -->
  <div
    class="marquee-wrap reveal relative mt-14 md:mt-20"
    style="--reveal-delay:260ms"
    aria-label="Screenshots from the projects"
  >
    <div class="marquee gap-4 px-4">
      {
        loop.map((item, i) => (
          <a
            href={item.href}
            aria-hidden={i >= rail.length ? "true" : undefined}
            tabindex={i >= rail.length ? -1 : undefined}
            class="group relative block h-[8.5rem] w-[15rem] shrink-0 overflow-hidden rounded-xl border border-line bg-surface md:h-[11rem] md:w-[19.5rem]"
          >
            <img
              src={thumb(item.src)}
              alt={i >= rail.length ? "" : item.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-left-top opacity-80 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
            />
            <span class="absolute inset-x-0 bottom-0 block truncate bg-gradient-to-t from-black/90 via-black/60 to-transparent px-3 pb-2.5 pt-8 font-mono text-[0.625rem] tracking-wide text-white/70">
              <span class="text-white">{item.name}</span> — {item.caption}
            </span>
          </a>
        ))
      }
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-bg to-transparent md:w-40"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-bg to-transparent md:w-40"
      aria-hidden="true"
    >
    </div>
  </div>
</section>
