---
import { heroStats, person } from "../data/site";

// Each letter becomes a small spring. Words stay whole so lines never break mid-word.
const lines = [
  { word: "Software", ghost: false },
  { word: "Engineer", ghost: true },
];
const total = lines.reduce((n, l) => n + l.word.length, 0);
---

<section id="top" class="scroll-mt-24">
  <h1
    class="hero-title drift-title text-[clamp(2.9rem,6.55vw,5.9rem)]"
    data-drift
    data-total={total}
    aria-label="Software engineer"
  >
    {
      lines.map((line) => (
        <span class:list={["block whitespace-nowrap", line.ghost && "ghost"]} aria-hidden="true">
          {[...line.word].map((ch) => (
            <span class="ch">{ch}</span>
          ))}
        </span>
      ))
    }
  </h1>

  <p
    class="drift-status mt-5 flex items-center gap-3 font-mono text-[0.8125rem] text-mute"
    data-drift-status
    data-state="sync"
    aria-live="polite"
  >
    <span class="dot" aria-hidden="true"></span>
    <span data-text>In sync.</span>
  </p>

  <p class="mt-8 max-w-[31rem] text-[1.125rem] leading-relaxed text-dim">
    I build things, then try to break them. Controllers, internal platforms and
    pipelines, mostly in Go, and every number on this page is measured.
  </p>

  <dl class="mt-14 flex flex-wrap gap-x-12 gap-y-8">
    {
      heroStats.map((stat) => (
        <div>
          <dt class="font-hero text-[clamp(2.5rem,4.4vw,3.9rem)] font-bold leading-[1.1] tracking-[-0.02em] [font-variation-settings:'wdth'_112]">
            {stat.value}
          </dt>
          <dd class="mt-1 max-w-[10rem] text-[0.9375rem] leading-snug text-mute">{stat.label}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-[4.5rem] grid gap-[30px] sm:grid-cols-[300fr_366fr]">
    <a href="#work" class="tile bg-[#f26a37] text-white">
      <svg class="pattern" viewBox="0 0 300 240" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M-10 225 C 60 205, 120 160, 170 140 S 160 40, 230 25 S 300 30, 320 20" stroke="rgba(150,40,10,0.28)" stroke-width="3"></path>
        <path d="M-10 140 C 50 120, 110 90, 150 60 S 220 -10, 320 10" stroke="rgba(150,40,10,0.18)" stroke-width="3"></path>
      </svg>
      <svg class="relative h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 11a8 8 0 0 0-14.9-3M4 5v4h4M4 13a8 8 0 0 0 14.9 3M20 19v-4h-4"></path>
      </svg>
      <span class="relative mt-6">
        <span class="block font-hero text-[1.5rem] font-semibold leading-[1.1] [font-variation-settings:'wdth'_110]">
          Controllers, platforms, pipelines
        </span>
        <span class="go mt-4 ml-auto" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </span>
      </span>
    </a>

    <a href={person.github} rel="me noopener" class="tile bg-[#c5ff41] text-[#141210]">
      <svg class="pattern" viewBox="0 0 366 240" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M-10 40 L 60 -10 L 110 150 L 180 20 L 230 230 L 300 60 L 380 200" stroke="rgba(60,210,170,0.55)" stroke-width="3" stroke-linejoin="round"></path>
        <path d="M-10 120 L 40 60 L 100 250 L 170 110 L 240 260 L 320 120 L 380 260" stroke="rgba(60,210,170,0.4)" stroke-width="3" stroke-linejoin="round"></path>
      </svg>
      <svg class="relative h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path>
      </svg>
      <span class="relative mt-6">
        <span class="block font-hero text-[1.5rem] font-semibold leading-[1.1] [font-variation-settings:'wdth'_110]">
          Open source, benchmarks included
        </span>
        <span class="go mt-4 ml-auto" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"></path></svg>
        </span>
      </span>
    </a>
  </div>
</section>

<script>
  // Drift and reconcile. The pointer knocks letters out of place (drift), a
  // damped spring pulls each one back (reconcile), and the status line reports
  // what happened with a real, measured duration. Motion only runs while
  // something is out of place, and not at all with reduced motion.
  const title = document.querySelector<HTMLElement>("[data-drift]");
  const status = document.querySelector<HTMLElement>("[data-drift-status]");
  const label = status?.querySelector<HTMLElement>("[data-text]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (title && status && label && !reduce) {
    type Spring = { el: HTMLElement; k: number; cx: number; cy: number; x: number; y: number; r: number; vx: number; vy: number; vr: number };
    const total = Number(title.dataset.total);
    const springs: Spring[] = [...title.querySelectorAll<HTMLElement>(".ch")].map((el) => ({
      // Slightly different springs, so the letters do not move in lockstep.
      el, k: 0.045 + Math.random() * 0.02, cx: 0, cy: 0, x: 0, y: 0, r: 0, vx: 0, vy: 0, vr: 0,
    }));

    // Rest positions in page coordinates, so scrolling never invalidates them.
    const measure = () => {
      for (const s of springs) {
        const b = s.el.getBoundingClientRect();
        s.cx = b.left + b.width / 2 - s.x + window.scrollX;
        s.cy = b.top + b.height / 2 - s.y + window.scrollY;
      }
    };

    let running = false;
    let driftSince = 0;
    let wasDrifting = false;
    let quiet = 0;

    const say = (state: "sync" | "drift", text: string) => {
      status.dataset.state = state;
      label.textContent = text;
    };

    const tick = () => {
      let moving = false;
      let drifted = 0;
      for (const s of springs) {
        s.vx = (s.vx - s.x * s.k) * 0.86;
        s.vy = (s.vy - s.y * s.k) * 0.86;
        s.vr = (s.vr - s.r * 0.07) * 0.84;
        s.x += s.vx;
        s.y += s.vy;
        s.r += s.vr;
        const off = Math.hypot(s.x, s.y);
        if (off > 0.08 || Math.abs(s.r) > 0.08 || Math.abs(s.vx) + Math.abs(s.vy) > 0.05) moving = true;
        if (off > 4 || Math.abs(s.r) > 4 || Math.hypot(s.vx, s.vy) > 1.5) drifted++;
        s.el.style.transform = `translate(${s.x.toFixed(2)}px, ${s.y.toFixed(2)}px) rotate(${s.r.toFixed(2)}deg)`;
        s.el.classList.toggle("is-drifting", off > 10);
      }

      // Only call it in sync after a few still frames, so a letter passing
      // through its rest position mid-swing does not count as reconciled.
      if (drifted > 0) {
        if (!wasDrifting) driftSince = performance.now();
        wasDrifting = true;
        quiet = 0;
        say("drift", `Drift on ${drifted} of ${total} letters. Reconciling.`);
      } else if (wasDrifting && ++quiet >= 12) {
        wasDrifting = false;
        const ms = Math.round(performance.now() - driftSince);
        say("sync", `In sync. Reconciled in ${ms} ms; the operator does it in 50.`);
      }

      if (moving) {
        requestAnimationFrame(tick);
      } else {
        running = false;
        for (const s of springs) {
          s.x = s.y = s.r = s.vx = s.vy = s.vr = 0;
          s.el.style.transform = "";
        }
      }
    };

    const wake = () => {
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    // The pointer pushes letters within reach, harder the faster it moves.
    let px = 0, py = 0, pt = 0;
    window.addEventListener(
      "pointermove",
      (e) => {
        const now = performance.now();
        const dt = Math.max(now - pt, 8);
        const speed = Math.min(Math.hypot(e.pageX - px, e.pageY - py) / dt, 4);
        px = e.pageX; py = e.pageY; pt = now;
        const reach = 120;
        let hit = false;
        for (const s of springs) {
          const dx = s.cx + s.x - e.pageX;
          const dy = s.cy + s.y - e.pageY;
          const d = Math.hypot(dx, dy) || 1;
          if (d > reach) continue;
          const f = (1 - d / reach) ** 2 * (1.2 + speed * 3);
          s.vx += (dx / d) * f * 6;
          s.vy += (dy / d) * f * 6;
          s.vr += (dx > 0 ? 1 : -1) * f * 3;
          hit = true;
        }
        if (hit) wake();
      },
      { passive: true },
    );

    // One orchestrated moment on load: the title arrives out of place and reconciles.
    const start = () => {
      measure();
      for (const s of springs) {
        s.x = (Math.random() - 0.5) * 260;
        s.y = (Math.random() - 0.5) * 160;
        s.r = (Math.random() - 0.5) * 70;
      }
      wake();
    };
    (document.fonts?.ready ?? Promise.resolve()).then(start);
    window.addEventListener("resize", measure, { passive: true });
  }
</script>
