---
import { person } from "../data/site";
import { asset } from "../lib/url";

const socials = [
  {
    label: "GitHub",
    href: person.github,
    path: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.830 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z",
    fill: true,
  },
  {
    label: "LinkedIn",
    href: person.linkedin,
    path: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3Zm6.5 0h3.8v1.5h.05c.53-1 1.83-1.85 3.78-1.85 4.04 0 4.79 2.55 4.79 5.87v5.48h-4v-4.86c0-1.16-.02-2.65-1.7-2.65-1.7 0-1.96 1.26-1.96 2.57v4.94h-4Z",
    fill: true,
  },
  {
    label: "Source of this site",
    href: `${person.github}/mampiz.dev`,
    path: "m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16",
    fill: false,
  },
  {
    label: "Email",
    href: `mailto:${person.email}`,
    path: "M3.5 6.5h17v11h-17ZM3.5 7l8.5 6.5L20.5 7",
    fill: false,
  },
];
---

<aside
  class="profile-card rounded-2xl px-5 py-7 lg:sticky lg:top-10 lg:px-5 lg:py-[30px]"
  aria-label={`About ${person.short}`}
>
  <div class="flex items-center gap-5 lg:flex-col lg:gap-0">
    <img
      src={asset("media/avatar.jpg")}
      alt={person.name}
      width="580"
      height="677"
      decoding="async"
      class="h-28 w-24 shrink-0 rounded-2xl object-cover object-top lg:h-[284px] lg:w-[240px]"
    />

    <div class="min-w-0 lg:mt-6 lg:text-center">
      <p class="font-hero text-[1.75rem] font-bold leading-none tracking-[-0.025em] lg:text-[2.25rem]">
        {person.short}
      </p>
      <p class="dim mt-3 text-[0.9375rem] font-medium leading-snug lg:mx-auto lg:mt-5 lg:max-w-[16.5rem] lg:text-[1.0625rem]">
        {person.cardLine}
      </p>
    </div>
  </div>

  <ul class="mt-6 flex items-center gap-5 lg:mt-8 lg:justify-center" aria-label="Links">
    {
      socials.map((item) => (
        <li>
          <a
            href={item.href}
            rel={item.href.startsWith("http") ? "me noopener" : undefined}
            aria-label={item.label}
            title={item.label}
            class="block text-[color:var(--c-card-accent)] transition-transform duration-200 hover:-translate-y-0.5"
          >
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill={item.fill ? "currentColor" : "none"}
              stroke={item.fill ? "none" : "currentColor"}
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.path} />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
