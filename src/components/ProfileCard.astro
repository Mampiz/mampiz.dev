---
import { person } from "../data/site";
import { asset } from "../lib/url";

const socials = [
  {
    label: "GitHub",
    href: person.github,
    path: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z",
    fill: true,
  },
  {
    label: "LinkedIn",
    href: person.linkedin,
    path: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3Zm6.5 0h3.8v1.5h.05c.53-1 1.83-1.85 3.78-1.85 4.04 0 4.79 2.55 4.79 5.87v5.48h-4v-4.86c0-1.16-.02-2.65-1.7-2.65-1.7 0-1.96 1.26-1.96 2.57v4.94h-4Z",
    fill: true,
  },
  {
    label: "Source of this site",
    href: `${person.github}/mampiz.dev`,
    path: "m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16",
    fill: false,
  },
  {
    label: "Email",
    href: `mailto:${person.email}`,
    path: "M3.5 6.5h17v11h-17ZM3.5 7l8.5 6.5L20.5 7",
    fill: false,
  },
];
---

<aside
  class="profile-card relative overflow-hidden rounded-3xl p-5 sm:p-6 lg:sticky lg:top-24 lg:p-7"
  aria-label={`About ${person.short}`}
>
  <!-- Dashed arc in the corner, as on the reference card. Desktop only. -->
  <svg
    class="pointer-events-none absolute -left-12 -top-12 hidden h-52 w-52 text-accent lg:block"
    viewBox="0 0 200 200"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="100" cy="100" r="92" stroke="currentColor" stroke-width="2.5" stroke-dasharray="6 7" stroke-linecap="round"></circle>
  </svg>

  <div class="relative flex items-center gap-5 lg:flex-col lg:items-stretch lg:gap-6">
    <img
      src={asset("media/avatar.jpg")}
      alt={person.name}
      width="512"
      height="512"
      decoding="async"
      class="h-24 w-24 shrink-0 rounded-2xl object-cover object-top sm:h-28 sm:w-28 lg:aspect-[6/7] lg:h-auto lg:w-full"
    />

    <div class="min-w-0 lg:text-center">
      <p class="font-hero text-xl font-bold leading-tight tracking-[-0.02em] sm:text-2xl lg:text-[1.75rem]">
        {person.name}
      </p>
      <p class="dim mt-1.5 font-mono text-[0.6875rem] uppercase tracking-[0.16em]">
        {person.role} · {person.location}
      </p>
      <!-- A small round badge on a dashed path: the reconcile loop, our version of the flame. -->
      <div class="relative mt-5 hidden h-10 lg:block" aria-hidden="true">
        <svg class="absolute inset-y-0 -left-7 h-full w-[calc(50%+1.75rem)] text-accent" viewBox="0 0 150 40" preserveAspectRatio="none" fill="none">
          <path d="M0 38 Q 60 40 128 20" stroke="currentColor" stroke-width="2.5" stroke-dasharray="6 7" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
        </svg>
        <span class="absolute left-1/2 top-1/2 grid h-9 w-9 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-accent text-accent-ink">
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 11a8 8 0 0 0-14.9-3M4 5v4h4M4 13a8 8 0 0 0 14.9 3M20 19v-4h-4"></path>
          </svg>
        </span>
      </div>

      <p class="dim mt-3 hidden text-sm leading-relaxed lg:block">
        {person.tagline}
      </p>
    </div>
  </div>

  <ul
    class="relative mt-5 flex items-center gap-4 lg:mt-5 lg:justify-center"
    aria-label="Links"
  >
    {
      socials.map((item) => (
        <li>
          <a
            href={item.href}
            rel={item.href.startsWith("http") ? "me noopener" : undefined}
            aria-label={item.label}
            title={item.label}
            class="grid h-9 w-9 place-items-center rounded-full text-accent transition-transform duration-200 hover:scale-110"
          >
            <svg
              class="h-[22px] w-[22px]"
              viewBox="0 0 24 24"
              fill={item.fill ? "currentColor" : "none"}
              stroke={item.fill ? "none" : "currentColor"}
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.path} />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  <a
    href={asset("snake")}
    class="relative mt-5 flex items-center justify-between gap-3 rounded-xl border border-accent/30 bg-accent-soft px-4 py-2.5 text-sm text-accent transition-colors duration-200 hover:border-accent/60"
  >
    <span class="flex items-center gap-2">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z"></path>
      </svg>
      Play Reconcile
    </span>
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.14em] opacity-70">a game</span>
  </a>
</aside>
