---
interface Props {
  /** First line, in full ink. */
  title: string;
  /** Second line, a ghost of the first. */
  ghost?: string;
  blurb?: string;
}

const { title, ghost, blurb } = Astro.props;
---

<div class="reveal">
  <h2 class="hero-title text-[clamp(2.3rem,4.9vw,4.4rem)]">
    {title}
    {ghost && <span class="ghost">{ghost}</span>}
  </h2>
  {blurb && <p class="mt-4 max-w-md text-base leading-relaxed text-mute">{blurb}</p>}
</div>
