---
interface Props {
  index: string;
  title: string;
  blurb?: string;
}

const { index, title, blurb } = Astro.props;
---

<div class="reveal flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
  <div class="flex items-baseline gap-4 md:gap-6">
    <span class="label text-accent">{index}</span>
    <h2
      class="font-display text-[clamp(1.75rem,4vw,2.75rem)] font-semibold tracking-[-0.04em]"
    >
      {title}
    </h2>
  </div>
  {blurb && <p class="max-w-md text-sm leading-relaxed text-mute">{blurb}</p>}
</div>
