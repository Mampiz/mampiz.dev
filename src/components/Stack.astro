---
import { tools, toolbox } from "../data/site";
import { asset } from "../lib/url";
import SectionHead from "./SectionHead.astro";

// Everything that is not already in the grid, as a quiet line of chips.
const inGrid = new Set(tools.map((t) => t.name));
const rest = toolbox
  .flatMap((group) => group.items)
  .filter((item, i, all) => !inGrid.has(item) && all.indexOf(item) === i);
---

<section id="tools" class="section scroll-mt-10">
  <SectionHead title="Daily" ghost="tools" />

  <ul class="mt-5 grid gap-x-6 sm:grid-cols-2">
    {
      tools.map((tool, i) => (
        <li class="reveal flex items-center gap-4 px-4 py-4" style={`--reveal-delay:${(i % 2) * 60}ms`}>
          <span class="grid h-[60px] w-[60px] shrink-0 place-items-center rounded-lg bg-white">
            <span
              class="block h-8 w-8"
              style={`background:${tool.color};-webkit-mask:url(${asset(`icons/${tool.icon}.svg`)}) center/contain no-repeat;mask:url(${asset(`icons/${tool.icon}.svg`)}) center/contain no-repeat`}
              aria-hidden="true"
            ></span>
          </span>
          <span>
            <span class="block font-hero text-[1.375rem] font-semibold leading-tight tracking-[-0.01em]">
              {tool.name}
            </span>
            <span class="block text-base text-mute">{tool.note}</span>
          </span>
        </li>
      ))
    }
  </ul>

  <p class="reveal mt-8 px-4 text-sm uppercase tracking-[0.06em] text-mute">Also</p>
  <ul class="reveal mt-3 flex flex-wrap gap-2 px-4" aria-label="Other tools">
    {rest.map((item) => <li class="chip !text-[0.75rem]">{item}</li>)}
  </ul>
</section>
