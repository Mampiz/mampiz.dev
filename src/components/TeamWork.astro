---
import { teamwork } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section id="team" class="shell scroll-mt-24 border-t border-line py-16 md:py-24">
  <SectionHead
    title="Team work"
    blurb="Shared repositories, described by what I actually merged rather than by what the team shipped."
  />

  <article class="mt-12">
    <header
      class="reveal flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3"
    >
      <div class="flex items-center gap-4 md:gap-6">
        <h3
          class="font-display text-[clamp(1.9rem,4.4vw,3.25rem)] font-semibold leading-none tracking-[-0.04em]"
        >
          {teamwork.name}
        </h3>
        <span
          class="rounded-full border border-accent/40 bg-accent-soft px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-accent"
        >
          {teamwork.badge}
        </span>
      </div>
      <span class="label">{teamwork.kicker} · {teamwork.year}</span>
    </header>

    <p
      class="reveal mt-5 max-w-3xl font-display text-[clamp(1.15rem,2.2vw,1.6rem)] font-medium leading-snug tracking-[-0.02em] text-dim"
      style="--reveal-delay:60ms"
    >
      {teamwork.headline}
    </p>

    <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-12 lg:gap-12">
      <!-- The contribution is the point of the entry, so it gets the wide column. -->
      <div class="reveal lg:col-span-7" style="--reveal-delay:120ms">
        <div
          class="overflow-hidden rounded-2xl border border-line bg-surface shadow-[var(--shadow-card)]"
        >
          <div class="border-b border-line bg-surface-2 px-5 py-3">
            <span class="label">What I wrote</span>
          </div>
          <ul>
            {
              teamwork.did.map((item) => (
                <li class="flex gap-3.5 border-b border-line-soft px-5 py-4 last:border-b-0">
                  <svg
                    class="mt-1 h-3.5 w-3.5 shrink-0 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 12.5 9 17.5 20 6.5" />
                  </svg>
                  <span class="text-[0.9375rem] leading-relaxed text-dim">
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="reveal lg:col-span-5" style="--reveal-delay:180ms">
        <div class="space-y-5 text-[0.9375rem] leading-relaxed text-dim">
          {teamwork.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Technologies">
          {teamwork.stack.map((tech) => <li class="chip">{tech}</li>)}
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm">
          {
            teamwork.links.map((link) => (
              <a href={link.url} class="link" rel="noopener">
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <dl
      class="reveal mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-4"
      style="--reveal-delay:220ms"
    >
      {
        teamwork.metrics.map((metric) => (
          <div class="bg-bg px-5 py-6">
            <dt class="font-display text-2xl font-semibold tracking-[-0.03em] text-accent md:text-[1.75rem]">
              {metric.value}
            </dt>
            <dd class="mt-1.5 font-mono text-[0.6875rem] leading-relaxed text-mute">
              {metric.label}
            </dd>
          </div>
        ))
      }
    </dl>
  </article>
</section>
