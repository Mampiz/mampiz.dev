---
import { projects } from "../data/site";
import { asset, thumb } from "../lib/url";
---

<ul class="mt-5" aria-label="Projects">
  {
    projects.map((project, i) => (
      <li class="reveal" style={`--reveal-delay:${i * 50}ms`}>
        <a
          href={`#${project.slug}`}
          data-peek={project.art ? asset(project.art) : undefined}
          class="index-row group flex items-start gap-5 rounded-xl px-4 py-5"
        >
          <span class="relative block h-[100px] w-[96px] shrink-0 overflow-hidden rounded-lg bg-surface-2 sm:h-[135px] sm:w-[130px]">
            {project.art ? (
              <img
                src={asset(project.art)}
                alt=""
                loading="lazy"
                decoding="async"
                width="130"
                height="135"
                class="thumb h-full w-full object-cover"
              />
            ) : project.cover.kind === "image" ? (
              <img
                src={thumb(project.cover.src)}
                alt=""
                loading="lazy"
                decoding="async"
                width="260"
                height="270"
                class="thumb h-full w-full object-cover object-left-top"
              />
            ) : (
              <span class="grid h-full w-full place-items-center bg-accent px-1 text-center font-hero text-xl font-bold tracking-[-0.03em] text-accent-ink sm:text-2xl">
                {project.cover.figure}
              </span>
            )}
          </span>

          <span class="min-w-0 flex-1 self-center">
            <span class="block font-hero text-[1.375rem] font-semibold leading-tight tracking-[-0.01em] text-ink sm:text-[1.75rem]">
              {project.name}
            </span>
            <span class="mt-1.5 block text-base text-mute">
              {project.kicker}
            </span>
          </span>

          <svg
            class="mt-1 h-5 w-5 shrink-0 text-accent transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<div class="peek" data-peek-box aria-hidden="true"><img alt="" data-peek-img /></div>

<script>
  // The cover of the hovered project trails the pointer, tilting with its
  // speed. Mouse only; touch and reduced motion keep the plain list.
  const box = document.querySelector<HTMLElement>("[data-peek-box]");
  const img = document.querySelector<HTMLImageElement>("[data-peek-img]");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (box && img && fine && !reduce) {
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0, on = false;
    const step = () => {
      const dx = tx - x;
      x += dx * 0.16;
      y += (ty - y) * 0.16;
      const tilt = Math.max(-8, Math.min(8, dx * 0.2));
      box.style.transform = `translate(${x - 95}px, ${y - 99}px) rotate(${tilt}deg)`;
      raf = on || Math.abs(dx) > 0.5 ? requestAnimationFrame(step) : 0;
    };
    document.querySelectorAll<HTMLAnchorElement>("[data-peek]").forEach((row) => {
      row.addEventListener("pointerenter", (e) => {
        img.src = row.dataset.peek!;
        if (!on) { x = tx = e.clientX + 175; y = ty = e.clientY; }
        on = true;
        box.classList.add("is-on");
        if (!raf) raf = requestAnimationFrame(step);
      });
      row.addEventListener("pointermove", (e) => { tx = e.clientX + 175; ty = e.clientY; });
      row.addEventListener("pointerleave", () => { on = false; box.classList.remove("is-on"); });
    });
  }
</script>
