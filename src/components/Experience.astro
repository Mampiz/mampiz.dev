---
import { experience, person } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section id="experience" class="section scroll-mt-10">
  <SectionHead title="Two years of" ghost="experience" />

  <ul class="mt-5">
    {
      experience.map((item, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
          <a
            href={person.linkedin}
            rel="me noopener"
            class="index-row group flex items-start justify-between gap-6 rounded-xl px-4 py-6"
          >
            <span class="min-w-0">
              <span class="block font-hero text-[1.375rem] font-semibold leading-tight tracking-[-0.01em] sm:text-[1.75rem]">
                {item.company}
              </span>
              <span class="mt-1 block text-sm font-medium uppercase tracking-[0.06em] text-accent">
                {item.role}
              </span>
              <span class="mt-3 block max-w-[30rem] text-base leading-relaxed text-mute">
                {item.text}
              </span>
              <span class="mt-4 block text-base text-dim">{item.dates}</span>
            </span>
            <svg
              class="mt-1 h-5 w-5 shrink-0 text-accent transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8"></path>
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</section>
