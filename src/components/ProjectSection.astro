---
import type { Project } from "../data/site";
import MediaPanel from "./MediaPanel.astro";
import Diagram from "./Diagram.astro";

interface Props {
  project: Project;
  flip: boolean;
}

const { project, flip } = Astro.props;

/** Escape, then turn `backticks` into inline code. */
function richText(input: string): string {
  const escaped = input
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return escaped.replace(
    /`([^`]+)`/g,
    '<code class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-[0.85em] text-accent">$1</code>',
  );
}
---

<article
  id={project.slug}
  class="scroll-mt-24 border-t border-line py-16 first:border-t-0 md:py-24"
>
  <!-- Title row -->
  <header class="reveal flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
    <div class="flex items-baseline gap-4 md:gap-6">
      <span class="label text-accent">{project.index}</span>
      <h3
        class="font-display text-[clamp(1.9rem,4.4vw,3.25rem)] font-semibold leading-none tracking-[-0.04em]"
      >
        {project.name}
      </h3>
    </div>
    <div class="flex items-center gap-3">
      {
        project.status && (
          <span class="rounded-full border border-accent/40 bg-accent-soft px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-accent">
            {project.status}
          </span>
        )
      }
      <span class="label">{project.kicker} · {project.year}</span>
    </div>
  </header>

  <p
    class="reveal mt-5 max-w-3xl font-display text-[clamp(1.15rem,2.2vw,1.6rem)] font-medium leading-snug tracking-[-0.02em] text-dim"
    style="--reveal-delay:60ms"
  >
    {project.headline}
  </p>

  <!-- Media + narrative -->
  <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-12 lg:gap-12">
    <div
      class:list={[
        "reveal lg:col-span-7",
        flip ? "lg:order-2 lg:col-start-6" : "",
      ]}
      style="--reveal-delay:120ms"
    >
      {
        project.media.length > 0 ? (
          <MediaPanel items={project.media} label={project.name} />
        ) : (
          <Diagram kind={project.diagram!} label={`${project.name} · how it fits together`} />
        )
      }
    </div>

    <div
      class:list={["reveal lg:col-span-5", flip ? "lg:order-1 lg:row-start-1" : ""]}
      style="--reveal-delay:180ms"
    >
      <div class="space-y-5 text-[0.9375rem] leading-relaxed text-dim">
        {project.body.map((paragraph) => <p set:html={richText(paragraph)} />)}
      </div>

      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Technologies">
        {project.stack.map((tech) => <li class="chip">{tech}</li>)}
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm">
        {
          project.repo && (
            <a href={project.repo} class="link" rel="noopener">
              <svg
                class="h-4 w-4"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              Source
            </a>
          )
        }
        {
          project.demo && (
            <a href={project.demo} class="link text-accent" rel="noopener">
              {project.demoLabel ?? "Live"}
              <svg
                class="arrow h-3 w-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Measured facts, not adjectives -->
  <dl
    class:list={[
      "reveal mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line",
      // Never leave a hole in the last row.
      project.metrics.length % 3 === 0
        ? "grid-cols-1 sm:grid-cols-3"
        : "grid-cols-2 md:grid-cols-4",
    ]}
    style="--reveal-delay:220ms"
  >
    {
      project.metrics.map((metric) => (
        <div class="bg-bg px-5 py-6">
          <dt class="font-display text-2xl font-semibold tracking-[-0.03em] text-accent md:text-[1.75rem]">
            {metric.value}
          </dt>
          <dd class="mt-1.5 font-mono text-[0.6875rem] leading-relaxed text-mute">
            {metric.label}
          </dd>
        </div>
      ))
    }
  </dl>
</article>
