---
import { nav } from "../data/site";
import { siteBase } from "../lib/url";

interface Props {
  /** True on pages other than the index, where the anchors have no targets. */
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
const home = `${siteBase}/`;
const link = (hash: string) => (standalone ? `${home}${hash}` : hash);

// Stroke icons, 24px grid. Hand-written so the nav needs no icon library.
const icons: Record<string, string> = {
  home: "M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10",
  work: "M3 7a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z",
  merge: "M7 4v10M7 14a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM17 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM17 10v1.5a3 3 0 0 1-3 3H7",
  team: "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 20c.6-3.4 3.2-5 6.5-5s5.9 1.6 6.5 5M16 4.4a3.5 3.5 0 0 1 0 6.2M18 15.3c1.9.6 3.1 2.1 3.5 4.7",
  stack: "m12 3 9 5-9 5-9-5ZM3 12.5l9 5 9-5M3 16.5l9 5 9-5",
  about: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4.5 20.5c.8-3.6 3.7-5.5 7.5-5.5s6.700 1.900 7.500 5.500",
  mail: "M3.5 6.5h17v11h-17ZM3.5 7l8.500 6.500L20.500 7",
};
---

<div class="progress" data-progress aria-hidden="true"></div>

<header
  data-header
  class="pointer-events-none fixed inset-x-0 top-3 z-50 flex justify-center px-3 md:top-5"
>
  <nav
    class="pill pointer-events-auto flex items-center gap-0.5 rounded-full p-1.5"
    aria-label="Sections"
  >
    {
      nav.map((item) => (
        <a
          href={link(item.href)}
          data-nav-link
          title={item.label}
          aria-label={item.label}
          class="grid h-9 w-9 place-items-center rounded-full text-dim transition-colors duration-200 hover:text-ink data-[active]:bg-accent-soft data-[active]:text-accent md:h-10 md:w-10"
        >
          <svg
            class="h-[18px] w-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={icons[item.icon]} />
          </svg>
        </a>
      ))
    }

    <span class="mx-1 h-5 w-px bg-line" aria-hidden="true"></span>

    <button
      data-theme-toggle
      type="button"
      aria-label="Toggle colour theme"
      title="Theme"
      class="grid h-9 w-9 place-items-center rounded-full text-dim transition-colors duration-200 hover:text-ink md:h-10 md:w-10"
    >
      <svg
        class="hidden h-[17px] w-[17px] dark-only"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <svg
        class="hidden h-[17px] w-[17px] light-only"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </button>
  </nav>
</header>

<style>
  :global(html[data-theme="dark"]) .light-only {
    display: block;
  }
  :global(html[data-theme="light"]) .dark-only {
    display: block;
  }
</style>
