---
import { nav, person } from "../data/site";
---

<div class="progress" data-progress aria-hidden="true"></div>

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300 data-[scrolled]:border-b data-[scrolled]:border-line data-[scrolled]:bg-bg/75 data-[scrolled]:backdrop-blur-xl"
>
  <div class="shell flex h-16 items-center justify-between gap-6 md:h-[4.5rem]">
    <a
      href="#top"
      class="group flex items-baseline gap-2.5 font-display text-[0.95rem] font-semibold tracking-tight"
    >
      <span
        class="inline-block h-1.5 w-1.5 rounded-full bg-accent transition-transform duration-300 group-hover:scale-150"
      ></span>
      {person.short}
      <span class="hidden font-mono text-[0.6875rem] font-normal text-mute sm:inline"
        >/ {person.handle}</span
      >
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Sections">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="rounded-full px-3.5 py-1.5 text-sm text-dim transition-colors duration-200 hover:text-ink data-[active]:bg-surface data-[active]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle colour theme"
        class="grid h-9 w-9 place-items-center rounded-full border border-line text-dim transition-colors duration-200 hover:border-accent/50 hover:text-ink"
      >
        <svg
          class="hidden h-[15px] w-[15px] dark-only"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="hidden h-[15px] w-[15px] light-only"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href={`mailto:${person.email}`}
        class="btn btn-primary hidden !px-4 !py-2 !text-[0.8125rem] md:inline-flex"
      >
        Contact
      </a>

      <button
        data-menu-button
        type="button"
        aria-expanded="false"
        aria-label="Open menu"
        class="grid h-9 w-9 place-items-center rounded-full border border-line text-dim md:hidden"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  data-menu
  class="pointer-events-none fixed inset-0 z-40 translate-y-[-8px] bg-bg/95 opacity-0 backdrop-blur-xl transition-all duration-300 data-[open]:pointer-events-auto data-[open]:translate-y-0 data-[open]:opacity-100 md:hidden"
>
  <nav class="shell flex h-full flex-col justify-center gap-2" aria-label="Sections">
    {
      nav.map((item, i) => (
        <a
          href={item.href}
          class="border-b border-line-soft py-5 font-display text-3xl tracking-tight text-ink"
        >
          <span class="label mr-4 align-middle">0{i + 1}</span>
          {item.label}
        </a>
      ))
    }
    <a href={`mailto:${person.email}`} class="btn btn-primary mt-8 justify-center">
      Contact
    </a>
  </nav>
</div>

<style>
  :global(html[data-theme="dark"]) .light-only {
    display: block;
  }
  :global(html[data-theme="light"]) .dark-only {
    display: block;
  }
</style>
